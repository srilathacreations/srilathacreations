{
  "name": "srilatha",
  "compatibility_date": "2026-08-28",
  "main": "src/index.js",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "srilatha-store-db",
      "database_id": "c07b8893-1355-4eff-8b25-6cd070dd7ae4"
    }
  ]
}
